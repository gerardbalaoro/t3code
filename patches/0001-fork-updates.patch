From 3dec2a18ba0797918425d911be03ae62ead78b78 Mon Sep 17 00:00:00 2001
From: Gerard Balaoro <gerardbalaoro@gmail.com>
Date: Sun, 15 Nov 2026 12:19:20 +0800
Subject: [PATCH] feat(release): update from gerardbalaoro/t3code releases

Builds from this fork would otherwise download upstream's binaries and replace themselves. Point `t3 update`, the install scripts, SSH host installs and the startup recovery link at the fork's releases.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/desktop/src/app/DesktopStartupRecovery.ts    |  2 +-
 .../settings/environment-maintenance.test.ts      | 15 ++++++++++-----
 apps/server/src/cli/update.test.ts                |  2 +-
 packages/shared/src/cliRelease.ts                 |  2 +-
 packages/ssh/src/tunnel.test.ts                   |  5 ++++-
 scripts/install.ps1                               |  2 +-
 scripts/install.sh                                |  2 +-
 7 files changed, 19 insertions(+), 11 deletions(-)

diff --git a/apps/desktop/src/app/DesktopStartupRecovery.ts b/apps/desktop/src/app/DesktopStartupRecovery.ts
index 768fe2ee3d..54cd9c53a8 100644
--- a/apps/desktop/src/app/DesktopStartupRecovery.ts
+++ b/apps/desktop/src/app/DesktopStartupRecovery.ts
@@ -20,7 +20,7 @@ import * as DesktopEnvironment from "./DesktopEnvironment.ts";
 import * as DesktopObservability from "./DesktopObservability.ts";
 import * as DesktopState from "./DesktopState.ts";
 
-const RELEASES_URL = "https://github.com/pingdotgg/t3code/releases";
+const RELEASES_URL = "https://github.com/gerardbalaoro/t3code/releases";
 const LAST_STARTED_VERSION_FILE = "desktop-last-started-version";
 // Buttons are plain links to this host; will-navigate cancels them and runs the action.
 const ACTION_ORIGIN = "https://startup-recovery.invalid";
diff --git a/apps/mobile/src/features/settings/environment-maintenance.test.ts b/apps/mobile/src/features/settings/environment-maintenance.test.ts
index 86b104a45e..cccb05556d 100644
--- a/apps/mobile/src/features/settings/environment-maintenance.test.ts
+++ b/apps/mobile/src/features/settings/environment-maintenance.test.ts
@@ -58,7 +58,7 @@ describe("environment release checks", () => {
   const signal = new AbortController().signal;
   const feed = (...tags: ReadonlyArray<string>) =>
     new Response(
-      `<feed><id>tag:github.com,2008:https://github.com/pingdotgg/t3code/releases</id>${tags
+      `<feed><id>tag:github.com,2008:https://github.com/gerardbalaoro/t3code/releases</id>${tags
         .map((tag) => `<entry><id>tag:github.com,2008:Repository/1/${tag}</id></entry>`)
         .join("")}</feed>`,
     );
@@ -67,7 +67,7 @@ describe("environment release checks", () => {
     vi.stubGlobal(
       "fetch",
       vi.fn(async (url: string) =>
-        url === "https://github.com/pingdotgg/t3code/releases.atom"
+        url === "https://github.com/gerardbalaoro/t3code/releases.atom"
           ? feed(
               "desktop-preview",
               "v1.0.0-preview.20260924.3",
@@ -93,11 +93,16 @@ describe("environment release checks", () => {
     vi.stubGlobal(
       "fetch",
       vi.fn(async (url: string) => {
-        if (url === "https://github.com/pingdotgg/t3code/releases.atom") return feed(...nightlies);
-        if (url === "https://api.github.com/repos/pingdotgg/t3code/releases?per_page=100&page=1") {
+        if (url === "https://github.com/gerardbalaoro/t3code/releases.atom")
+          return feed(...nightlies);
+        if (
+          url === "https://api.github.com/repos/gerardbalaoro/t3code/releases?per_page=100&page=1"
+        ) {
           return Response.json(Array.from({ length: 100 }, () => ({ tag_name: "v2.0.0" })));
         }
-        if (url === "https://api.github.com/repos/pingdotgg/t3code/releases?per_page=100&page=2") {
+        if (
+          url === "https://api.github.com/repos/gerardbalaoro/t3code/releases?per_page=100&page=2"
+        ) {
           return Response.json([
             { tag_name: "v1.0.0-preview.20260925.1", draft: true },
             { tag_name: "v1.0.0-preview.20260924.3" },
diff --git a/apps/server/src/cli/update.test.ts b/apps/server/src/cli/update.test.ts
